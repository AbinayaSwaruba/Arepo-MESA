    max_dt_for_relax_entropy = 1d-10
    max_steps_to_relax_entropy = 10000 
    num_timescales_for_relax_entropy = 100
    get_entropy_for_relax_from_eos= "" 


    save_model_when_terminate = .true.
    save_model_filename = 'relaxed_015381759_equipot_fin.mod'
    pgstar_flag= .false.
    disable_pgstar_during_relax_flag= .false.
    pause_before_terminate = .true.
